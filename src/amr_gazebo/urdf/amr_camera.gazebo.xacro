<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- RGB camera (Gazebo Classic libgazebo_ros_camera.so) -->
  <xacro:property name="camera_update_rate" value="30.0"/>
  <xacro:property name="camera_hfov" value="1.3962634"/>
  <xacro:property name="camera_width_px" value="640"/>
  <xacro:property name="camera_height_px" value="480"/>

  <xacro:macro name="amr_camera_gazebo">

    <gazebo reference="camera_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo reference="camera_link">
      <sensor name="camera" type="camera">
        <!-- Sensor at lens (front of camera_link box); optical frame via plugin -->
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>${camera_update_rate}</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>${camera_hfov}</horizontal_fov>
          <image>
            <width>${camera_width_px}</width>
            <height>${camera_height_px}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>15.0</far>
          </clip>
        </camera>
        <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/</namespace>
            <remapping>/camera/image_raw:=/image_raw</remapping>
            <remapping>/camera/camera_info:=/camera_info</remapping>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>camera_optical_frame</frame_name>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
